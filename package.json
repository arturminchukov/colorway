{
  "name": "colorway",
  "version": "0.1.2",
  "description": "Recolors picked elements of any site and marks the tab so instances are told apart",
  "private": true,
  "license": "MIT",
  "author": "Artur Minchukov",
  "type": "module",
  "packageManager": "yarn@4.15.0+sha512.07ec708ac11e2eaa4ea2b04cfbb272812f7e74a753f1595eaef4486c663a98306a30cca3e6fc40f7a0b168dcfb3a2490b6a5e0501e20fb69cc36f563dd161c53",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "package:source": "node scripts/package-source.mjs",
    "sign:firefox": "node scripts/build.mjs && node scripts/sign-firefox.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/webextension-polyfill": "^0.12.5",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
